{
  "name": "instant-quote-widget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Embeddable LawnStarter-style instant quote & booking widget (React + TS + Tailwind + Framer Motion). Standalone, WordPress-compatible.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && vite build --config vite.embed.config.ts",
    "build:wp": "npm run build:embed && node scripts/copy-to-wp-plugin.mjs",
    "build:all": "npm run build && npm run build:wp",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
